# Email delivery — Resend preferred, SendGrid used as fallback
RESEND_API_KEY=
SENDGRID_API_KEY=
TO_EMAIL=you@example.com
FROM_EMAIL=digest@yourdomain.com

# Discord Twitter-dump feed (TweetShift channels)
DISCORD_BOT_TOKEN=

# Claude API — farm report + baseball pulse
ANTHROPIC_KEY=

# League data
COMBINED_PLAYERS_PATH=data/combined_players.json
MY_TEAM_ABBR=WAR

# offseason (default): Twitter-feed analysis only. inseason: full digest.
DIGEST_MODE=offseason

# Optional: write digest_preview.html instead of sending email
# DIGEST_DRY_RUN=1
